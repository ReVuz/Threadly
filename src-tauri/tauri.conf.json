{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threadly",
  "version": "0.1.0",
  "identifier": "app.threadly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Threadly",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/**/*",
          "$LOCALDATA/**",
          "$LOCALDATA/**/*",
          "$HOME/.local/share/app.threadly.desktop/**",
          "$HOME/.local/share/app.threadly.desktop/**/*",
          "$HOME/.config/app.threadly.desktop/**",
          "$HOME/.config/app.threadly.desktop/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
